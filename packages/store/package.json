{
  "name": "@commissary/store",
  "version": "0.1.1",
  "description": "Typed persistence contracts and Store operator fallbacks for Commissary",
  "homepage": "https://github.com/spiritledsoftware/commissary#readme",
  "bugs": {
    "url": "https://github.com/spiritledsoftware/commissary/issues"
  },
  "license": "MIT",
  "author": "Spirit-Led Software LLC <social@spiritledsoftware.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/spiritledsoftware/commissary.git",
    "directory": "packages/store"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    },
    "./sql": {
      "types": "./dist/sql/index.d.ts",
      "import": "./dist/sql/index.js"
    },
    "./sql/adapter": {
      "types": "./dist/sql/adapter.d.ts",
      "import": "./dist/sql/adapter.js"
    },
    "./sql/postgres": {
      "types": "./dist/sql/postgres/index.d.ts",
      "import": "./dist/sql/postgres/index.js"
    },
    "./sql/postgres/adapter": {
      "types": "./dist/sql/postgres/adapter.d.ts",
      "import": "./dist/sql/postgres/adapter.js"
    },
    "./sql/conformance": {
      "types": "./dist/sql/conformance.d.ts",
      "import": "./dist/sql/conformance.js"
    },
    "./transaction-adapter": {
      "types": "./dist/transaction-adapter.d.ts",
      "import": "./dist/transaction-adapter.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "pack:check": "node ../../scripts/check-package-archive.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
