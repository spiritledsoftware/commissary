[
 {
  "name": "request: system, images, tools, tool_result, tool_choice and stop sequences",
  "from": "claude",
  "to": "openai",
  "model": "gpt-4o",
  "stream": true,
  "request": {
   "model": "claude-sonnet-4",
   "max_tokens": 1024,
   "temperature": 0.7,
   "stop_sequences": [
    "END",
    "\u003cstop\u003e"
   ],
   "system": [
    {
     "type": "text",
     "text": "You are helpful."
    },
    {
     "type": "text",
     "text": "x-anthropic-billing-header: cc_version=1;"
    }
   ],
   "messages": [
    {
     "role": "user",
     "content": [
      {
       "type": "text",
       "text": "What is in this image? \u003cb\u003e"
      },
      {
       "type": "image",
       "source": {
        "type": "base64",
        "media_type": "image/png",
        "data": "iVBORw0KGgo="
       }
      }
     ]
    },
    {
     "role": "assistant",
     "content": [
      {
       "type": "text",
       "text": "Let me check the weather."
      },
      {
       "type": "tool_use",
       "id": "toolu_01",
       "name": "get_weather",
       "input": {
        "city": "Paris",
        "units": "c"
       }
      }
     ]
    },
    {
     "role": "user",
     "content": [
      {
       "type": "tool_result",
       "tool_use_id": "toolu_01",
       "content": [
        {
         "type": "text",
         "text": "22C sunny"
        }
       ]
      },
      {
       "type": "text",
       "text": "Thanks, and tomorrow?"
      }
     ]
    }
   ],
   "tools": [
    {
     "name": "get_weather",
     "description": "Weather lookup",
     "input_schema": {
      "type": "object",
      "properties": {
       "city": {
        "type": "string"
       },
       "units": {
        "type": "string",
        "enum": [
         "c",
         "f"
        ]
       }
      },
      "required": [
       "city"
      ]
     }
    },
    {
     "name": "noop",
     "input_schema": {
      "type": "object"
     }
    }
   ],
   "tool_choice": {
    "type": "auto",
    "disable_parallel_tool_use": true
   },
   "user": "u-1"
  },
  "translatedRequest": "{\"model\":\"gpt-4o\",\"messages\":[{\"role\":\"system\",\"content\":[{\"type\":\"text\",\"text\":\"You are helpful.\"}]},{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"What is in this image? \u003cb\u003e\"},{\"type\":\"image_url\",\"image_url\":{\"url\":\"data:image/png;base64,iVBORw0KGgo=\"}}]},{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Let me check the weather.\"}],\"tool_calls\":[{\"function\":{\"arguments\":\"{\\\"city\\\":\\\"Paris\\\",\\\"units\\\":\\\"c\\\"}\",\"name\":\"get_weather\"},\"id\":\"toolu_01\",\"type\":\"function\"}]},{\"role\":\"tool\",\"tool_call_id\":\"toolu_01\",\"content\":\"22C sunny\",\"name\":\"get_weather\"},{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Thanks, and tomorrow?\"}]}],\"max_tokens\":1024,\"temperature\":0.7,\"stop\":[\"END\",\"\\u003cstop\\u003e\"],\"stream\":true,\"tools\":[{\"type\":\"function\",\"function\":{\"name\":\"get_weather\",\"description\":\"Weather lookup\",\"parameters\":{\"properties\":{\"city\":{\"type\":\"string\"},\"units\":{\"enum\":[\"c\",\"f\"],\"type\":\"string\"}},\"required\":[\"city\"],\"type\":\"object\"}}},{\"type\":\"function\",\"function\":{\"name\":\"noop\",\"description\":\"\",\"parameters\":{\"properties\":{},\"type\":\"object\"}}}],\"tool_choice\":\"auto\",\"parallel_tool_calls\":false,\"user\":\"u-1\"}"
