{
  "name": "@commissary/core",
  "version": "0.1.0",
  "description": "Durable, provider-neutral agent runtime for TypeScript",
  "homepage": "https://github.com/spiritledsoftware/commissary#readme",
  "bugs": {
    "url": "https://github.com/spiritledsoftware/commissary/issues"
  },
  "license": "MIT",
  "author": "Spirit-Led Software LLC <social@spiritledsoftware.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/spiritledsoftware/commissary.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "pack:check": "node ../../scripts/check-package-archive.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
