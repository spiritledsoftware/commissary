  "stream": false,
  "request": {
   "model": "gemini-2.5-flash",
   "input": [
    {
     "type": "message",
     "role": "user",
     "content": [
      {
       "type": "input_text",
       "text": "hi"
      }
     ]
    },
    {
     "type": "function_call_output",
     "call_id": "orphan-1",
     "namespace": "codex_app",
     "name": "create_thread",
     "output": "{\"thread\":\"t1\"}"
    },
    {
     "type": "message",
     "role": "user",
     "content": [
      {
       "type": "input_text",
       "text": "go on"
      }
     ]
    }
   ]
  },
  "executor": {
   "headers": {
    "X-Openai-Subagent": "collab_spawn"
   },
   "orphanDelegation": true
  },
  "translatedRequest": "{\"model\":\"gemini-2.5-flash\",\"input\":[{\"type\":\"user_input\",\"content\":[{\"type\":\"text\",\"text\":\"hi\"}]},{\"type\":\"user_input\",\"content\":[{\"type\":\"text\",\"text\":\"Tool output from codex_app__create_thread:\\n{\\\"thread\\\":\\\"t1\\\"}\"}]},{\"type\":\"user_input\",\"content\":[{\"type\":\"text\",\"text\":\"go on\"}]}]}"
 },
