  "from": "openai-response",
  "to": "interactions",
  "model": "gemini-2.5-flash",
  "stream": false,
  "request": {
   "model": "gemini-2.5-flash",
   "input": [
    {
     "type": "message",
     "role": "user",
     "content": [
      {
       "type": "input_text",
       "text": "hi"
      }
     ]
    },
    {
     "type": "agent_message",
     "author": "root",
     "recipient": "child",
     "internal_chat_message_metadata_passthrough": {
      "k": 1
     },
     "content": [
      {
       "type": "encrypted_content",
       "encrypted_content": "secret plan"
      },
      {
       "type": "input_text",
       "text": "visible"
      }
     ]
    },
    {
     "type": "message",
     "role": "assistant",
     "content": [
      {
       "type": "output_text",
       "text": "ok"
      }
     ]
    }
   ]
  },
  "executor": {
   "compat": true
  },
  "translatedRequest": "{\"model\":\"gemini-2.5-flash\",\"input\":[{\"type\":\"user_input\",\"content\":[{\"type\":\"text\",\"text\":\"hi\"}]},{\"type\":\"user_input\",\"content\":[{\"type\":\"text\",\"text\":\"secret plan\"},{\"type\":\"text\",\"text\":\"visible\"}]},{\"type\":\"model_output\",\"content\":[{\"type\":\"text\",\"text\":\"ok\"}]}]}"
 },
 {
  "name": "openai-response -\u003e interactions: orphan delegation output becomes a user message",
