{
  "name": "commissary",
  "version": "0.0.0",
  "private": true,
  "description": "Commissary: one service on Cloudflare Workers through which an org reaches models, tools, a browser and hosted agents, under its own credentials, grants and spend limits",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "catalog:sync": "node tools/sync-models-dev-catalog.ts",
    "toolkits:sync": "node tools/sync-integrations-sh-catalog.ts",
    "ci:setup": "alchemy deploy --config stacks/github.ts --stage ci --profile admin --adopt && alchemy state read commissary-github/ci/output --profile admin",
    "deploy": "alchemy deploy",
    "deploy:cloud": "alchemy deploy --stage cloud --env-file .env.cloud",
    "destroy": "alchemy destroy",
    "dev": "turbo run build --filter=@commissary/web && alchemy dev",
    "format": "oxfmt",
    "lint": "turbo run lint:root",
    "lint:root": "oxlint && oxfmt --check && tools/check-computerd.sh",
    "logs": "alchemy logs",
    "plan": "alchemy plan",
    "prepare": "effect-tsgo patch --no-typescript --oxlint && husky && ([ -n \"$CI\" ] || tools/sync-reference-repos.sh)",
    "repos:sync": "tools/sync-reference-repos.sh",
    "smoke": "sh tools/dev-smoke.sh",
    "test": "sh tools/test.sh",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc -p tsconfig.infra.json"
  },
  "devDependencies": {
    "@commissary/billing": "workspace:*",
    "@commissary/core": "workspace:*",
    "@commissary/models": "workspace:*",
    "@commissary/tools": "workspace:*",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@distilled.cloud/cloudflare": "1.0.0-rc.15",
    "@effect/platform-node": "4.0.5",
    "@effect/tsgo": "0.52.0",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "catalog:",
    "alchemy": "2.0.0-beta.83",
    "effect": "catalog:",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "turbo": "2.11.9",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{ts,mts,cts,js,mjs,cjs}": "oxlint --quiet --no-error-on-unmatched-pattern"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
