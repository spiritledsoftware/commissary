{
  "name": "commissary",
  "version": "0.0.0",
  "private": true,
  "description": "Durable, provider-neutral agent runtime for TypeScript",
  "homepage": "https://github.com/spiritledsoftware/commissary#readme",
  "bugs": {
    "url": "https://github.com/spiritledsoftware/commissary/issues"
  },
  "license": "MIT",
  "author": "Spirit-Led Software LLC <social@spiritledsoftware.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/spiritledsoftware/commissary.git"
  },
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm install && sh scripts/sync-reference-repos.sh",
    "changeset": "changeset",
    "build": "turbo run build",
    "check:changeset": "node scripts/check-changeset.mjs",
    "check:imports": "node scripts/check-built-imports.mjs",
    "conformance:browser": "node scripts/check-browser-runtime.mjs",
    "conformance:bun": "bun scripts/smoke-runtime.mjs",
    "conformance:cloudflare": "node scripts/check-cloudflare-runtime.mjs",
    "conformance:deno": "deno run --allow-env=MSGPACKR_NATIVE_ACCELERATION_DISABLED --allow-read --node-modules-dir=manual scripts/smoke-runtime.mjs",
    "conformance:node": "node scripts/smoke-runtime.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:staged": "lint-staged",
    "pack:check": "turbo run pack:check",
    "prepare": "husky && effect-tsgo patch --typescript --oxlint",
    "smoke": "pnpm run conformance:node",
    "release": "pnpm run build && changeset publish",
    "test": "turbo run test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm run format:check && pnpm run build && pnpm run lint && pnpm run test:scripts && turbo run typecheck test",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@commissary/core": "workspace:*",
    "@commissary/drizzle": "workspace:*",
    "@commissary/effect": "workspace:*",
    "@commissary/store": "workspace:*",
    "@commissary/store-memory": "workspace:*",
    "@commissary/stream": "workspace:*",
    "@effect/tsgo": "0.38.0",
    "@types/node": "^26.4.0",
    "bun": "^1.4.0",
    "deno": "^2.9.6",
    "drizzle-orm": "0.45.2",
    "drizzle-valibot": "0.4.2",
    "drizzle-zod": "0.8.3",
    "esbuild": "0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "miniflare": "4.20260730.0",
    "oxfmt": "^0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.62.1",
    "skills": "^1.5.23",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "valibot": "1.4.2",
    "vitest": "^4.1.11",
    "zod": "4.4.3",
    "zod3": "npm:zod@3.25.76"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@11.16.0"
}
