{
  "name": "commissary",
  "version": "0.0.0",
  "private": true,
  "description": "Commissary: one service on Cloudflare Workers through which an org reaches models, tools, a browser and hosted agents, under its own credentials, grants and spend limits",
  "license": "FSL-1.1-ALv2",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/vitest": "4.0.4",
      "@types/js-yaml": "4.0.9",
      "@types/node": "^26.6.5",
      "effect": "4.0.4",
      "jose": "^6.2.12",
      "js-yaml": "4.3.2",
      "tsrs": "0.20.1-ts7.1.0-beta",
      "vitest": "5.0.3"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "catalog:sync": "node tools/sync-models-dev-catalog.ts",
    "toolkits:sync": "node tools/sync-integrations-sh-catalog.ts",
    "ci:setup": "alchemy deploy --config stacks/github.ts --stage ci --profile admin --adopt && alchemy state read commissary-github/ci/output --profile admin",
    "deploy": "alchemy deploy",
    "deploy:cloud": "alchemy deploy --stage cloud --env-file .env.cloud",
    "destroy": "alchemy destroy",
    "dev": "turbo run build --filter=@commissary/web && alchemy dev",
    "format": "oxfmt",
    "lint": "turbo run lint:root",
    "lint:root": "oxlint && oxfmt --check && tools/check-computerd.sh",
    "logs": "alchemy logs",
    "plan": "alchemy plan",
    "prepare": "effect-tsgo patch --no-typescript --oxlint && husky && ([ -n \"$CI\" ] || tools/sync-reference-repos.sh)",
    "repos:sync": "tools/sync-reference-repos.sh",
    "smoke": "sh tools/dev-smoke.sh",
    "test": "sh tools/test.sh",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsrs -p tsconfig.infra.json"
  },
  "devDependencies": {
    "@commissary/billing": "workspace:*",
    "@commissary/core": "workspace:*",
    "@commissary/models": "workspace:*",
    "@commissary/tools": "workspace:*",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@distilled.cloud/cloudflare": "1.0.0-rc.15",
    "@effect/platform-bun": "4.0.4",
    "@effect/platform-node": "4.0.4",
    "@effect/tsgo": "0.56.1",
    "@oxlint/plugins": "1.87.0",
    "@types/node": "catalog:",
    "alchemy": "2.0.0-beta.83",
    "effect": "catalog:",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsrs": "catalog:",
    "turbo": "2.11.7"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.4",
    "just-bash": "3.2.0",
    "xpath": "0.0.34"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{ts,mts,cts,js,mjs,cjs}": "oxlint --quiet --no-error-on-unmatched-pattern"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "alchemy@2.0.0-beta.83": "patches/alchemy@2.0.0-beta.83.patch"
  },
  "trustedDependencies": [
    "esbuild",
    "oxlint",
    "oxlint-tsgolint",
    "workerd"
  ]
}
