{
  "name": "commissary",
  "version": "0.0.0",
  "private": true,
  "description": "Commissary: one service on Cloudflare Workers through which an org reaches models, tools, and a browser, under its own credentials, grants and spend limits",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "build": "vp run -r --cache build",
    "catalog:sync": "node tools/sync-models-dev-catalog.ts",
    "toolkits:sync": "node tools/sync-integrations-sh-catalog.ts",
    "ci:setup": "alchemy deploy --config stacks/github.ts --stage ci --profile admin --adopt && alchemy state read commissary-github/ci/output --profile admin",
    "deploy": "alchemy deploy",
    "deploy:cloud": "alchemy deploy --stage cloud --env-file .env.cloud",
    "destroy": "alchemy destroy",
    "dev": "vp run --filter @commissary/web --cache build && alchemy dev",
    "format": "vp fmt",
    "lint": "tools/oxlint.sh && vp fmt --check && tools/check-computerd.sh",
    "logs": "alchemy logs",
    "plan": "alchemy plan",
    "prepare": "effect-tsgo patch --no-typescript --tsrs && vp config --no-agent && ([ -n \"$CI\" ] || tools/sync-reference-repos.sh)",
    "repos:sync": "tools/sync-reference-repos.sh",
    "smoke": "sh tools/dev-smoke.sh",
    "test": "sh tools/test.sh",
    "typecheck": "vp run -r --parallel --concurrency-limit 10 --cache typecheck && vp run --cache typecheck:root",
    "typecheck:root": "tsrs -p tsconfig.infra.json"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/github": "2.0.0-beta.85",
    "@commissary/billing": "workspace:*",
    "@commissary/core": "workspace:*",
    "@commissary/models": "workspace:*",
    "@commissary/tools": "workspace:*",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@distilled.cloud/cloudflare": "1.0.0-rc.18",
    "@effect/platform-node": "4.1.2",
    "@effect/tsgo": "0.67.4",
    "@types/node": "catalog:",
    "alchemy": "2.0.0-beta.85",
    "effect": "catalog:",
    "tsrs": "catalog:",
    "vite-plus": "catalog:"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  },
  "packageManager": "pnpm@12.18.0"
}
