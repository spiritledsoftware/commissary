{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "pack:check": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@commissary/core#typecheck": {
      "dependsOn": ["build", "@commissary/store-memory#build"],
      "outputs": []
    },
    "@commissary/core#test": {
      "dependsOn": ["build", "@commissary/store-memory#build"],
      "outputs": []
    }
  }
}
