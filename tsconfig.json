{
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["@types/node"],
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "preserve",
    "noEmit": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true
  },
  "exclude": ["**/node_modules/**", "./apps/**", "./packages/**", "./tools/**"]
}
