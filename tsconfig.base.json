{
  // Compiler options every program of the workspace shares; each tsconfig adds its runtime (lib, types) and files.
  // There is no emit: bundlers (Alchemy, Vite, Vitest) compile the TypeScript, `tsrs` only checks it.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // The Effect language service's diagnostics, which `tsrs` reports once `effect-tsgo patch --tsrs` (the root `prepare`
    // script) has patched it (ADR 0047): the rule defaults, which are @effect/tsgo's recommended preset, plus
    // anyUnknownInErrorContext and unsafeEffectTypeAssertion as errors and strictEffectProvide as a warning. Errors fail
    // `bun run typecheck`; warnings and suggestions are reported only.
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "error",
          "strictEffectProvide": "warning",
          "unsafeEffectTypeAssertion": "error"
        },
        "ignoreEffectWarningsInTscExitCode": true
      }
    ]
  }
}
