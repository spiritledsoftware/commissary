{
  "servers": {
    "oxfmt": {
      "command": "pnpm",
      "args": ["exec", "oxfmt", "--lsp"]
    },
    "oxlint": {
      "command": "pnpm",
      "args": ["exec", "oxlint", "--lsp"]
    },
    "typescript-language-server": {
      "command": "pnpm",
      "args": ["exec", "tsc", "--lsp", "--stdio"]
    }
  }
}
