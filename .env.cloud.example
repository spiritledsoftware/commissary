# Settings of the `cloud` stage (docs/DEPLOY.md "The Commissary Cloud stage"): Commissary Cloud (ADR 0026) deployed next to
# the self-hosted Commissary. Copy to .env.cloud (git-ignored). `pnpm deploy:cloud` deploys it from this file alone (not
# .env), and `pnpm ci:setup` writes it into the GitHub environment `cloud`, which CI deploys from main.

COMMISSARY_MODE=cloud
# Commissary Cloud's base domain (ADR 0031; not the self-hosted one's): the app host and the auth host are under it
# (the API host may be too), and it scopes the session cookie, so every host under it receives that cookie (a landing
# page on the base domain too). Its zone must already be in the Cloudflare account.
COMMISSARY_DOMAIN=example.com
# The app host (ADR 0031): the control panel, the sign-in page and the management API; COMMISSARY_DOMAIN or a host
# under it. Default: COMMISSARY_DOMAIN.
COMMISSARY_APP_DOMAIN=app.example.com
# Optional auth host (ADR 0030): the auth Worker's hostname, where people sign in; a subdomain of COMMISSARY_DOMAIN other
# than the app host and the API host. Default: auth.<COMMISSARY_DOMAIN>.
# COMMISSARY_AUTH_DOMAIN=auth.example.com
# Optional API host (ADR 0028): the API Worker's hostname, the only one of the client API (/v1, /v1beta, /responses,
# ...), which leave the app host. Unset: zone routes send the client API paths of the app host to the API Worker
# (ADR 0030).
COMMISSARY_API_DOMAIN=api.example.com
# Platform admins: people who sign in with one of these emails, verified by the provider.
PLATFORM_ADMIN_EMAILS=you@example.com

# At least one sign-in provider (both values of a provider). OAuth callback URLs, on the auth host:
# https://auth.<COMMISSARY_DOMAIN>/api/auth/callback/github (and /google), or COMMISSARY_AUTH_DOMAIN's. A GitHub OAuth app takes one callback host, so
# this one is not the app of the Commissary Cloud previews.
SIGN_IN_GITHUB_CLIENT_ID=
SIGN_IN_GITHUB_CLIENT_SECRET=
# SIGN_IN_GOOGLE_CLIENT_ID=
# SIGN_IN_GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile widget (required) listing the app host (COMMISSARY_APP_DOMAIN) among its hostnames (the sign-in
# page is on the app host).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate-limit namespaces, one per plan (the ceilings, 60 and 600 requests a minute, are constants): positive integers
# unique in the account and different from each other, so not the previews' (the Pay as you go one defaults to the
# Free one plus one).
ORG_RATE_LIMIT_NAMESPACE_ID=7201
# ORG_RATE_LIMIT_PAYG_NAMESPACE_ID=7202
# OWNED_ORG_LIMIT=3

# Pay as you go through production Polar (docs/DEPLOY.md "Polar"): all three or none (none: nothing is billed and the
# billing routes answer 404). An organization access token, the webhook endpoint's secret (endpoint
# https://<app host>/webhooks/polar) and the Pay-as-you-go product's id.
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_PRODUCT_ID=

# The sandbox's computer (#223; docs/DEPLOY.md "Optional pieces"): off unless set on; `pnpm ci:setup` writes it into
# the `cloud` environment. Its instance size defaults to standard-1.
# COMMISSARY_COMPUTER=on
# COMMISSARY_COMPUTER_INSTANCE=standard-1
