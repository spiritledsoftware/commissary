# Deploy settings for `pnpm run deploy` (alchemy.run.ts, infra/settings.ts). Copy to .env (git-ignored); shell
# variables override it. Cloudflare credentials are not set here: run `pnpm exec alchemy profile edit --add Cloudflare`
# once (or set CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN in CI).

# Base domain of Commissary (ADR 0031), and its hostname unless COMMISSARY_APP_DOMAIN names another; its zone must
# already be in the Cloudflare account. With COMMISSARY_API_DOMAIN set, the app host serves the control panel and the
# management API, behind Access.
COMMISSARY_DOMAIN=commissary.example.com
# Optional app host (ADR 0031): the app Worker's hostname and its Access application's, COMMISSARY_DOMAIN or a host
# under it (which frees the base domain for a landing page). Default: COMMISSARY_DOMAIN.
# COMMISSARY_APP_DOMAIN=app.commissary.example.com
# Optional API host (ADR 0028): the API Worker's hostname, the only one of the client API (/v1, /v1beta, /responses,
# ...), outside Access (clients send API keys). Unset: zone routes send the client API paths of the app host to
# the API Worker (ADR 0030) and the deploy takes them out of Access with a bypass application. Pull-request previews
# ignore it.
# COMMISSARY_API_DOMAIN=api.commissary.example.com
# Zero Trust team name (myteam) or domain (myteam.cloudflareaccess.com).
ACCESS_TEAM_DOMAIN=myteam

# Who may pass Access (comma separated). People log in with your identity provider...
ACCESS_ALLOW_EMAILS=you@example.com
ACCESS_ALLOW_EMAIL_DOMAINS=
# ...tools use service tokens: one per client/machine, created by the deploy. Their credentials are written to
# .alchemy/access-service-tokens.json on the deploying machine.
ACCESS_SERVICE_TOKENS=
# Service tokens managed outside this stack, by token ID (not Client ID), also admitted: e.g. the CI token used by the
# post-deploy check (docs/DEPLOY.md). Keep it equal to the GitHub environment variable of the same name.
ACCESS_ALLOW_SERVICE_TOKEN_IDS=

# Platform admins (ADR 0022): they manage every org, create orgs, and use the management API and the control panel
# (/o/<org>/). Emails, and service token names from above or Client IDs.
PLATFORM_ADMIN_EMAILS=you@example.com
PLATFORM_ADMIN_SERVICE_TOKENS=

# Optional
# ACCESS_SESSION_DURATION=24h
# Single-header service tokens: Access reads {"cf-access-client-id": ..., "cf-access-client-secret": ...} from this header.
# ACCESS_SERVICE_TOKEN_HEADER=x-api-key
# Managed OAuth for MCP clients signing in to the app host's /mcp (ADR 0045, docs/ACCESS.md), off by default while
# Cloudflare has it in open beta (it makes Access answer the app host's non-browser requests 401, see ACCESS.md).
# With it on: the redirect URIs a client may register (https or a client's own scheme; replaces the defaults, Claude's
# and Cursor's hosted callbacks), and whether clients on localhost/127.0.0.1 may (Claude Code, Codex, Cursor's desktop
# app). Not with ACCESS_AUD.
# ACCESS_MANAGED_OAUTH=true
# ACCESS_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://www.cursor.com/agents/mcp/oauth/callback
# ACCESS_OAUTH_LOOPBACK_CLIENTS=true
# Use an Access application managed outside this stack instead (its AUD tag); ACCESS_ALLOW_* and
# ACCESS_SERVICE_TOKENS are then ignored/rejected.
# ACCESS_AUD=
# META_MINT_URL=
# CPU limit per request in ms (Workers Paid; lower it on plans with smaller limits).
# COMMISSARY_CPU_MS=300000

# `pnpm dev` only: identity of the local admin (every localhost request is treated as this user).
# ACCESS_DEV_BYPASS=dev@example.com

# Rotation of the secrets key that wraps every org's data key (docs/DEPLOY.md "Secrets key"): raise the generation to
# mint a new key, and keep the old generation as the previous one until every org started under the new key.
# SECRETS_KEY_GENERATION=1
# SECRETS_KEY_PREVIOUS_GENERATION=

# Commissary Cloud (ADR 0026, docs/DEPLOY.md "Commissary Cloud"): the auth Worker signs people in with GitHub and/or
# Google on the auth host (ADR 0030) and no Access application is created; the ACCESS_* settings above are then
# ignored. Platform admins are the people in PLATFORM_ADMIN_EMAILS. OAuth callback URLs:
# https://<auth host>/api/auth/callback/github (and /google). With `pnpm dev`, Commissary Cloud runs locally (the auth
# Worker on :1340, callbacks http://localhost:1340/api/auth/callback/github, Turnstile's test keys by default).
# COMMISSARY_MODE=cloud
# The auth host: a subdomain of COMMISSARY_DOMAIN other than the app host and the API host (default
# auth.<COMMISSARY_DOMAIN>). The session cookie is scoped to COMMISSARY_DOMAIN, so every host under it receives it.
# COMMISSARY_AUTH_DOMAIN=
# At least one sign-in provider (both values of a provider):
# SIGN_IN_GITHUB_CLIENT_ID=
# SIGN_IN_GITHUB_CLIENT_SECRET=
# SIGN_IN_GOOGLE_CLIENT_ID=
# SIGN_IN_GOOGLE_CLIENT_SECRET=
# Cloudflare Turnstile widget (required) for the app host, where the sign-in page shows it: guards sign-in and sign-up.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# How many orgs a person may own unless a platform admin raises it (default 3).
# OWNED_ORG_LIMIT=3
# The rate-limit namespaces of the request-rate ceilings of the Free plan and of Pay as you go (60 and 600 requests a
# minute per org, constants in code): positive integers unique in the account and different from each other (the
# Free one defaults to 7201, the Pay as you go one to the Free one plus one; give every Commissary Cloud stage its own).
# ORG_RATE_LIMIT_NAMESPACE_ID=7201
# ORG_RATE_LIMIT_PAYG_NAMESPACE_ID=7202

# Not set here: AUTH_INDEX_KEY, the secret HMAC key of `auth_index`. Each deployed stage mints its own random key on
# its first deploy and keeps it in the Alchemy state (alchemy.run.ts); `pnpm dev` uses the fixed DEV_AUTH_INDEX_KEY
# and the tests the key in apps/app/vitest.config.ts. Likewise SECRETS_KEY (minted per generation, DEV_SECRETS_KEY in
# `pnpm dev`) and, on Commissary Cloud, BETTER_AUTH_SECRET.
